# CommercePulse_AI_Network — environment template
# Copy to .env for local development. On Render, add values under Environment.

NODE_ENV=development
PORT=3000
DATA_DIR=./data
CORS_ORIGINS=*
SESSION_SECRET=replace_with_a_long_random_secret

# Optional AI/model keys. The app has deterministic fallback logic when these are blank.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# Optional external data providers. Leave blank for demo-safe fallback mode.
NASA_FIRMS_MAP_KEY=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
DATA_GOV_IN_KEY=
IUCN_TOKEN=
EBIRD_TOKEN=
